# Example .env file — copy to .env and fill real values (do NOT commit secrets)
# Notes:
# - Replace placeholder values with your own credentials and endpoints.
# - If a password contains special characters (e.g. @), URL-encode them when used in connection strings (e.g. @ -> %40).

# Dial / LLM provider
DIAL_API_KEY=
AZURE_ENDPOINT=
API_VERSION=2024-02-01
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-005
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Postgres database (individual parts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=user
DB_PASSWORD=changeme

# MCP server configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080

# Langfuse (optional)
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Pinecone (optional)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=e-commerce-brain

# Application settings
APP_NAME="AI Operations Brain"
APP_VERSION="1.0.0"
DEBUG=false

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Full database URL (optional). If used, URL-encode special characters in the password.
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# Job settings
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_SECONDS=300
